          "title": "数字 / 模拟 / RF / 时钟供电",
          "sub": "1.0V · 1.8V · 3.3V · 5V 等",
          "meta": "另含负电源 / 偏置电源",
          "kind": "power",
          "detail": "电源网络包括 +1V0_FPGA、+1V8_FPGA、+1V8_CLOCK、多组 +3V3 / +5V0、-5V0_ADAR、-3V3_SW 及 ±5V5_PA 等。此列表不是上电顺序表，精确顺序以固件和电源管理资料为准。",
          "sources": [
            "power",
            "mcu"
          ]
        }
