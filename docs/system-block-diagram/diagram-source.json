{
  "graphs": [
    {
      "id": "overview",
      "title": "整机框图",
      "caption": "从主机、数字处理、模拟收发到阵列天线；下方展开系统控制、时钟与供电。",
      "w": 1800,
      "h": 890,
      "nodes": [
        {
          "id": "host",
          "x": 40,
          "y": 230,
          "w": 240,
          "h": 170,
          "title": "上位机",
          "sub": "Python 雷达 GUI",
          "meta": "显示 · 参数设置 · 数据记录",
          "kind": "data",
          "detail": "接收距离像、多普勒数据与检测结果；下发处理参数。FPGA 数据口与 STM32 USB CDC 管理口是两条独立连接。GUI_V65_Tk 与 GUI_V7_PyQt 是 README 指出的活动版本。",
          "sources": [
            "readme",
            "top",
            "mcu"
          ]
        },
        {
          "id": "digital",
          "x": 410,
          "y": 230,
          "w": 270,
          "h": 170,
          "title": "数字处理与 USB",
          "sub": "{fpgaShort}",
          "meta": "{usbShort}",
          "kind": "data",
          "detail": "FPGA 生成 Chirp、接收 ADC 数据并执行脉压、MTI、Doppler 与 CFAR。50T 主板 U42=XC7A50T-2FTG256I，U6=FT2232HQ；200T 开发目标为 XC7A200T-2FBG484I，使用 FT601。切换本页选项仅改变图的展示。",
          "sources": [
            "main",
            "top",
            "targets",
            "build200"
          ]
        },
        {
          "id": "analog",
          "x": 800,
          "y": 230,
          "w": 270,
          "h": 170,
          "title": "模拟收发链路",
          "sub": "AD9708 / AD9484",
          "meta": "LTC5552 ×2 · 滤波 / 驱动",
          "kind": "rf",
          "detail": "发射：8 位 DAC → 重建低通 → 上变频 → RF 带通。接收：RF 带通 → 下变频 → IF 滤波 / AD8352 驱动 → 8 位 ADC。两条链路经 RF 开关接入公共阵列端口。",
          "sources": [
            "main",
            "ref",
            "rx"
          ]
        },
        {
          "id": "beam",
          "x": 1190,
          "y": 230,
          "w": 240,
          "h": 170,
          "title": "阵列射频前端",
          "sub": "ADAR1000 ×4",
          "meta": "ADTR1107 ×16",
          "kind": "rf",
          "detail": "四片四通道 ADAR1000 实现 16 路相位与增益控制；每路连接一片 ADTR1107 收发前端。EP4RKU+ 在公共端口与四片 ADAR1000 之间完成分配 / 合成。属于模拟波束赋形，不是 16 组独立 ADC。",
          "sources": [
            "main",
            "readme"
          ]
        },
        {
          "id": "antenna",
          "x": 1550,
          "y": 230,
          "w": 210,
          "h": 170,
          "title": "阵列天线",
          "sub": "{antenna}",
          "meta": "{frontEnd}",
          "kind": "rf",
          "detail": "项目描述提供 8×16 贴片阵列与 32×16 波导阵列两类方案。16 路射频通道对应馈电子阵；不要将 16 路等同于 16 个贴片。增强方案在发射路径加入 16 路 QPA2962；接收信号绕过外置功放。",
          "sources": [
            "readme",
            "ref",
            "pa"
          ]
        },
        {
          "id": "sensors",
          "x": 40,
          "y": 620,
          "w": 240,
          "h": 150,
          "title": "定位与姿态",
          "sub": "UM982 · GY-85",
          "meta": "BMP180 气压计",
          "kind": "ctrl",
          "detail": "当前 MCU 主程序使用 UM982，旧框图中的 NEO-6M 已作为历史信息处理。GPS、IMU 与气压信息供位置标记、姿态修正与监控使用。",
          "sources": [
            "mcu",
            "readme",
            "ref"
          ]
        },
        {
          "id": "mcu",
          "x": 410,
          "y": 620,
          "w": 270,
          "h": 150,
          "title": "系统管理 MCU",
          "sub": "STM32F746ZGT7",
          "meta": "配置 · 扫描 · 监测 · 时序",
          "kind": "ctrl",
          "detail": "配置 AD9523 / ADF4382A 与 ADAR1000，协调 FPGA 扫描时序，管理 PA 偏置与电源顺序，读取传感器、温度和电流，控制电机 / 散热。通过自身 USB FS CDC 与上位机通信。",
          "sources": [
            "main",
            "mcu",
            "readme"
          ]
        },
        {
          "id": "clocks",
          "x": 800,
          "y": 620,
          "w": 270,
          "h": 150,
          "title": "时钟与本振板",
          "sub": "AD9523 + ADF4382A ×2",
          "meta": "ADC / DAC / FPGA 时钟 · TX/RX LO",
          "kind": "clock",
          "detail": "参考振荡器经 AD9523 分配时钟，两片 ADF4382A 分别产生发射和接收本振。ADC 采样设计为 400 MHz，DAC 侧逻辑使用 120 MHz，FPGA 主处理域为 100 MHz。频率数值是文件中的设计 / 配置值，不代表上板测量。",
          "sources": [
            "clock",
            "top",
            "ddc",
            "ref"
          ]
        },
        {
          "id": "power",
          "x": 1190,
          "y": 620,
          "w": 240,
          "h": 150,
          "title": "电源管理板",
          "sub": "DC/DC · LDO · 负电源",
          "meta": "MCU 控制上 / 下电顺序",
          "kind": "power",
          "detail": "原理图包含 TPS562208、TPS7A8300、LM2662。供电覆盖数字逻辑、射频、模拟和时钟等模块；总览仅画部分供电连接，完整关系见时钟与控制视图。外置 QPA2962 的漏极供电与继电器属于增强方案。",
          "sources": [
            "power",
            "mcu",
            "readme"
          ]
        }
